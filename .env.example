# Exemple pour un déploiement persistant. Ne pas utiliser ces valeurs telles
# quelles et ne jamais versionner le fichier contenant les secrets réels.
DATABASE_URL=postgresql://petits_pas:CHANGE_ME@postgresql:5432/petits_pas

# Choisir un seul stockage. Pour des médias privés sur disque persistant,
# laisser CARNET_S3_BUCKET absent et définir un chemin absolu hors du dépôt :
# CARNET_MEDIA_ROOT=/chemin/persistant/prive/media
# Variante stockage objet :
CARNET_S3_BUCKET=petits-pas
CARNET_S3_ENDPOINT_URL=https://s3.example.org
CARNET_S3_REGION=us-east-1
CARNET_S3_ACCESS_KEY=CHANGE_ME
CARNET_S3_SECRET_KEY=CHANGE_ME
CARNET_S3_URL_EXPIRATION=300

# Envoi d'e-mail (invitations, réinitialisation de mot de passe). En production,
# choisir explicitement un backend ou poser CARNET_EMAIL_DESACTIVE=oui.
CARNET_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
CARNET_EMAIL_HOTE=smtp.example.org
CARNET_EMAIL_PORT=587
CARNET_EMAIL_UTILISATEUR=CHANGE_ME
CARNET_EMAIL_MOT_DE_PASSE=CHANGE_ME
CARNET_EMAIL_TLS=oui
# Adresse fictive : à remplacer par une adresse d'un domaine réel (SPF/DKIM).
CARNET_EMAIL_EXPEDITEUR=Petits Pas <ne-pas-repondre@petits-pas.example>
# Alternative optionnelle, après installation de requirements-anymail.txt :
# CARNET_EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# CARNET_ANYMAIL_SENDGRID_CLE=CHANGE_ME
# Mode sans courrier assumé (à la place de CARNET_EMAIL_BACKEND et des secrets) :
# CARNET_EMAIL_DESACTIVE=oui

# Anti-bruteforce sur la connexion (actif par défaut hors CARNET_MODE_LOCAL).
# Valeurs par défaut : 5 échecs / 15 min, ou 10 / 5 min avec
# CARNET_ENVIRONNEMENT_EPHEMERE=oui. Ne renseigner que pour surcharger.
# CARNET_CONNEXION_TENTATIVES_MAX=5
# CARNET_CONNEXION_BLOCAGE_MINUTES=15
# CARNET_ANTIBRUTEFORCE=non

# Reverse-proxy : nombre de proxys de confiance devant l'application (0 par
# défaut : seule l'adresse directe est lue). Valeur EXACTE requise ; voir
# DEPLOIEMENT.org avant de la renseigner.
# CARNET_PROXYS_NB=1
# CARNET_RATELIMIT_MOT_DE_PASSE_OUBLIE=5/h
# CARNET_RATELIMIT_CHANGEMENT_MOT_DE_PASSE=10/h

# Authentification à deux facteurs (série #C8, en cours de livraison ; voir
# DEPLOIEMENT.org avant de l'activer, surtout l'obligation). Absente tant que
# requirements-2fa.txt n'est pas installé et que CARNET_2FA_CLE est vide.
# Clé Fernet : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# À conserver : perdue, elle rend illisibles les secrets enregistrés. Plusieurs
# clés séparées par une virgule pour une rotation (la première chiffre).
# CARNET_2FA_CLE=
# Obligatoire jusqu'à, et désactivé à partir de : direction, responsable,
# associe, contributeur, sans_fonction (ou tous). Absentes : tout optionnel.
# CARNET_2FA_OBLIGATOIRE=direction
# CARNET_2FA_DESACTIVE_POUR=contributeur
# CARNET_2FA_DELAI_GRACE_JOURS=14
# CARNET_RATELIMIT_DOUBLE_FACTEUR=5/15m
# CARNET_RATELIMIT_DOUBLE_FACTEUR_IP=30/15m

CARNET_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
CARNET_DEBUG=0
CARNET_FORCER_HTTPS=oui
CARNET_HOSTS=petits-pas.example.org
CARNET_CSRF_ORIGINS=https://petits-pas.example.org

# Profil d'atelier pédagogique persistant à données exclusivement factices.
# Ne décommenter ces variables que pour cet environnement dédié.
# CARNET_ENVIRONNEMENT_ATELIER=oui
# CARNET_VERSION=0.4

# Requis uniquement par la première exécution de initialiser_atelier. Injecter
# ces valeurs comme secrets de la plate-forme, puis les retirer.
# CARNET_ATELIER_MDP_ENSEIGNANT=CHANGE_ME
# CARNET_ATELIER_MDP_DIRECTION=CHANGE_ME

# Port d'écoute de Gunicorn. Valeur par défaut : 8000.
PORT=8000

# Export complet d'écoles vers le format local : permission distincte de la
# direction, désactivée par défaut. Identifiants numériques séparés par virgules.
# Valeur * : toutes les écoles présentes et futures ; vide : aucune.
# Les données internes de TOUTES les classes seront téléchargeables.
# CARNET_EXPORT_ECOLES=1,2
# Export d'une seule classe par son responsable : autorisation indépendante.
# Même convention (identifiants d'ÉCOLES ; * seul = toutes ; vide = désactivé).
# En mode local, accessible au responsable sans variable ni worker.
# CARNET_EXPORT_CLASSES=*
# Dossier privé persistant, hors des médias/statiques et de tout chemin public.
# CARNET_EXPORT_ROOT=/chemin/prive/exports-ecoles
# Programmer chaque minute : python manage.py preparer_exports_ecoles
