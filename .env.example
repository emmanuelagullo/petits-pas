# Exemple pour un déploiement persistant. Ne pas utiliser ces valeurs telles
# quelles et ne jamais versionner le fichier contenant les secrets réels.
DATABASE_URL=postgresql://petits_pas:CHANGE_ME@postgresql:5432/petits_pas

CARNET_S3_BUCKET=petits-pas
CARNET_S3_ENDPOINT_URL=https://s3.example.org
CARNET_S3_REGION=us-east-1
CARNET_S3_ACCESS_KEY=CHANGE_ME
CARNET_S3_SECRET_KEY=CHANGE_ME
CARNET_S3_URL_EXPIRATION=300

# Envoi d'e-mail (invitations, réinitialisation de mot de passe). Backend
# SMTP générique par défaut ; laisser CARNET_EMAIL_BACKEND vide sauf pour
# basculer vers un backend django-anymail dédié à un prestataire.
CARNET_EMAIL_HOTE=smtp.example.org
CARNET_EMAIL_PORT=587
CARNET_EMAIL_UTILISATEUR=CHANGE_ME
CARNET_EMAIL_MOT_DE_PASSE=CHANGE_ME
CARNET_EMAIL_TLS=oui
CARNET_EMAIL_EXPEDITEUR=Petits Pas <ne-pas-repondre@petits-pas.example>
# CARNET_EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# CARNET_ANYMAIL_SENDGRID_CLE=CHANGE_ME

CARNET_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
CARNET_DEBUG=0
CARNET_FORCER_HTTPS=oui
CARNET_HOSTS=petits-pas.example.org
CARNET_CSRF_ORIGINS=https://petits-pas.example.org

# Profil d'atelier pédagogique persistant à données exclusivement factices.
# Ne décommenter ces variables que pour cet environnement dédié.
# CARNET_ENVIRONNEMENT_ATELIER=oui
# CARNET_VERSION=0.4

# Requis uniquement par la première exécution de initialiser_atelier. Injecter
# ces valeurs comme secrets de la plate-forme, puis les retirer.
# CARNET_ATELIER_MDP_ENSEIGNANT=CHANGE_ME
# CARNET_ATELIER_MDP_DIRECTION=CHANGE_ME

# Port d'écoute de Gunicorn. Valeur par défaut : 8000.
PORT=8000
